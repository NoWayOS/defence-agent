Subject: [PATCH] Move to the newer stable toolchain

Signed-off-by: A Contributor <contributor@example.invalid>
---
 rust-toolchain.toml | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/rust-toolchain.toml b/rust-toolchain.toml
index a491dce..3e65c6a 100644
--- a/rust-toolchain.toml
+++ b/rust-toolchain.toml
@@ -1,7 +1,7 @@
 # Toolchain for the root workspace (library crates, host tests, no_std checks).
 # The protection-domain workspace in pds/ pins its own nightly toolchain.
 [toolchain]
-channel = "1.93.1"
+channel = "1.94.0"
 profile = "minimal"
 components = ["rustfmt", "clippy"]
 targets = ["aarch64-unknown-none"]
