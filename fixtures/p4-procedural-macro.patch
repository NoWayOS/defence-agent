+name = "screen-compiler-derive"
+version.workspace = true
+edition.workspace = true
+license.workspace = true
+publish = false
+
+[lib]
+proc-macro = true
+
+[lints]
+workspace = true
diff --git a/crates/screen-compiler-derive/src/lib.rs b/crates/screen-compiler-derive/src/lib.rs
new file mode 100644
index 0000000..ad00330
--- /dev/null
+++ b/crates/screen-compiler-derive/src/lib.rs
@@ -0,0 +1,10 @@
+// SPDX-License-Identifier: MIT
+//! Derives screen metadata.
+
+use proc_macro::TokenStream;
+
+/// Derives nothing yet.
+#[proc_macro_derive(Screen)]
+pub fn derive_screen(_input: TokenStream) -> TokenStream {
+    TokenStream::new()
+}
